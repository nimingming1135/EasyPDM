# .NET
bin/
obj/
*.user

# Magazyn wgranych plików/załączników (EasyPDM.Api StorageRoot) — dane użytkownika, nie kod
/storage/

# Node / frontend
node_modules/
dist/

# Python (makro FreeCAD)
__pycache__/
*.pyc

# 本地辅助脚本与中间字典（翻译 CAD 宏中文用，非仓库源码）
_workfiles/

# Editor
.vscode/

# Docker — .env trzyma prawdziwe hasło do bazy, .env.example jest wzorem w repo
.env

# Lokalne dane dostępowe (hasło do bazy itd.) — appsettings.Local.json.example jest wzorem w repo
EasyPDM.Api/appsettings.Local.json

# Instalator Windows — publish/ i Output/ to wygenerowane artefakty budowy, nie kod
packaging/windows/publish/
packaging/windows/Output/

# Windows_installer/ trzyma gotowe instalatory (kilkadziesiąt MB każdy). Sam .exe jest
# artefaktem budowy, nie źródłem — w repo leży README.md i SHA256SUMS.txt, a plik wykonywalny
# wystawia się jako GitHub Release (albo buduje lokalnie, zob. README w tym katalogu).
# Wersjonowany .gitignore zamiast globalnego, żeby zasada była widoczna dla kontrybutorów.
Windows_installer/*.exe
